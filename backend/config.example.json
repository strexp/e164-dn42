{
  "server": {
    "port": 3000,
    "jwtSecret": "change-this-secret-in-production",
    "frontendUrl": "http://localhost:3001"
  },
  "e164": {
    "zone": "e164.dn42",
    "countryCode": "424",
    "rules": [
      {
        "asnMatch": "^424242(\\d{4})$",
        "numberFormat": "0$1"
      }
    ]
  },
  "dns": {
    "zoneFilePath": "../data/e164.dn42.zone",
    "extraRecords": [],
    "soa": {
      "ns": "ns1.yourdomain.dn42.",
      "email": "admin.yourdomain.dn42."
    },
    "maxNsServers": 4
  },
  "db": "db/e164.db",
  "oauth": []
}
